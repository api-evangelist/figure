{
  "opencollection": "1.0.0",
  "info": {
    "name": "HELOC Inquiries Encryption Loan Originator requests API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Loan Originator requests",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fetch loan originators by email or with pagination",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.test.figure.com/management/v1/loan-originator",
            "params": [
              {
                "name": "email",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Fetch loan originators by email or with pagination"
        }
      ]
    }
  ],
  "bundled": true
}